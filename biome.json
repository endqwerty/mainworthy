{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["src/**", "test/**", "bench/**", "scripts/**", "!scripts/test-timings.json", "*.json"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": { "noNonNullAssertion": "error" },
			"suspicious": { "noExplicitAny": "error" },
			"nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" },
			"a11y": { "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["Select"] } } }
		}
	}
}
