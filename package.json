{
	"name": "mainworthy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"mainworthy": "src/cli/main.ts"
	},
	"scripts": {
		"dev": "bun --watch src/cli/main.ts serve",
		"start": "NODE_ENV=production bun src/cli/main.ts serve",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun scripts/check.ts test",
		"check": "bun scripts/check.ts",
		"prebuild": "bun scripts/licences.ts --check-bun",
		"build": "NODE_ENV=production bun build --compile --minify --sourcemap --banner '/*! Mainworthy, Apache-2.0. Software from others is in this file; its licences and notices: /docs/licence */' src/cli/main.ts src/server/read-worker.ts --outfile dist/mainworthy"
	},
	"dependencies": {
		"@modelcontextprotocol/core": "^2.3.1",
		"@modelcontextprotocol/server": "^2.3.1",
		"@noble/hashes": "^2.4.0",
		"@tanstack/react-query": "^5.104.2",
		"@tanstack/react-virtual": "^3.14.15",
		"fractional-indexing": "^4.0.0",
		"qrcode-generator": "2.0.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"saxes": "6.0.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@modelcontextprotocol/client": "^2.3.1",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.0",
		"fast-check": "^4.10.2",
		"gpt-tokenizer": "^4.0.0",
		"playwright-core": "^1.64.0",
		"typescript": "^7.0.2"
	}
}
