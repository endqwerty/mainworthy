{
	"name": "casebook",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"bin": {
		"casebook": "src/cli/main.ts"
	},
	"scripts": {
		"dev": "bun --watch src/cli/main.ts serve",
		"start": "bun src/cli/main.ts serve",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test src test",
		"check": "bun run typecheck && bun run lint && bun run test",
		"build": "bun build --compile --minify --sourcemap src/cli/main.ts src/server/read-worker.ts --outfile dist/casebook"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@noble/hashes": "^2.4.0",
		"@tanstack/react-query": "^5.104.2",
		"@tanstack/react-virtual": "^3.14.15",
		"fractional-indexing": "^4.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"fast-check": "^4.10.2",
		"gpt-tokenizer": "^4.0.0",
		"playwright-core": "^1.64.0",
		"typescript": "^7.0.2"
	}
}
