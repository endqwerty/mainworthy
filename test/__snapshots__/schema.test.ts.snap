$function$
function receipt_result_fn: CREATE OR REPLACE FUNCTION public.receipt_result_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.quarantine_decision IS DISTINCT FROM NEW.quarantine_decision OR OLD.quarantine_exit IS DISTINCT FROM NEW.quarantine_exit OR OLD.signature IS DISTINCT FROM NEW.signature OR OLD.method IS DISTINCT FROM NEW.method OR OLD.batch IS DISTINCT FROM NEW.batch OR OLD.test IS DISTINCT FROM NEW.test OR OLD.target IS DISTINCT FROM NEW.target THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.result=NEW.id ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_run_delete_fn: CREATE OR REPLACE FUNCTION public.receipt_run_delete_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT OLD.run,OLD.result/32 WHERE EXISTS(SELECT 1 FROM merge_receipt_heads WHERE run=OLD.run) ON CONFLICT(run,bucket) DO NOTHING;

 RETURN OLD;
END;
$function$
function receipt_run_insert_fn: CREATE OR REPLACE FUNCTION public.receipt_run_insert_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT NEW.run,NEW.result/32 WHERE EXISTS(SELECT 1 FROM merge_receipt_heads WHERE run=NEW.run) ON CONFLICT(run,bucket) DO NOTHING;

 RETURN NEW;
END;
$function$
function receipt_run_update_new_fn: CREATE OR REPLACE FUNCTION public.receipt_run_update_new_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.run IS DISTINCT FROM NEW.run OR OLD.result IS DISTINCT FROM NEW.result OR OLD.outcome IS DISTINCT FROM NEW.outcome OR OLD.signature IS DISTINCT FROM NEW.signature OR OLD.flipped IS DISTINCT FROM NEW.flipped OR OLD.target IS DISTINCT FROM NEW.target OR OLD.test IS DISTINCT FROM NEW.test THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT NEW.run,NEW.result/32 WHERE EXISTS(SELECT 1 FROM merge_receipt_heads WHERE run=NEW.run) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_run_update_old_fn: CREATE OR REPLACE FUNCTION public.receipt_run_update_old_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.run IS DISTINCT FROM NEW.run OR OLD.result IS DISTINCT FROM NEW.result OR OLD.outcome IS DISTINCT FROM NEW.outcome OR OLD.signature IS DISTINCT FROM NEW.signature OR OLD.flipped IS DISTINCT FROM NEW.flipped OR OLD.target IS DISTINCT FROM NEW.target OR OLD.test IS DISTINCT FROM NEW.test THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT OLD.run,OLD.result/32 WHERE EXISTS(SELECT 1 FROM merge_receipt_heads WHERE run=OLD.run) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_target_fn: CREATE OR REPLACE FUNCTION public.receipt_target_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.line IS DISTINCT FROM NEW.line OR OLD.change IS DISTINCT FROM NEW.change OR OLD.repo IS DISTINCT FROM NEW.repo OR OLD.what IS DISTINCT FROM NEW.what OR OLD.env IS DISTINCT FROM NEW.env THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.target=NEW.id ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_test_fn: CREATE OR REPLACE FUNCTION public.receipt_test_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.name IS DISTINCT FROM NEW.name OR OLD.file IS DISTINCT FROM NEW.file OR OLD.no IS DISTINCT FROM NEW.no OR OLD.kind IS DISTINCT FROM NEW.kind THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.test=NEW.id ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function search_docs_vector_fn: CREATE OR REPLACE FUNCTION public.search_docs_vector_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE
 body_prefix text := coalesce(NEW.body, '');
 lower_chars integer := 0;
 upper_chars integer := 65536;
 middle_chars integer;
 parts text[];
 part integer := 1;
 vector tsvector;
 vectors tsvector[] := ARRAY[]::tsvector[];
BEGIN
 -- Keep a UTF-8 character boundary within the first 64 KiB of the body.
 IF octet_length(body_prefix) > 65536 THEN
  WHILE lower_chars < upper_chars LOOP
   middle_chars := (lower_chars + upper_chars + 1) / 2;
   IF octet_length(left(body_prefix, middle_chars)) <= 65536 THEN
    lower_chars := middle_chars;
   ELSE
    upper_chars := middle_chars - 1;
   END IF;
  END LOOP;
  body_prefix := left(body_prefix, lower_chars);
 END IF;
 -- Three vectors of at most 256 KiB stay below tsvector's 1 MiB limit when joined.
 -- Normal titles and tags remain whole; oversized fields retain a searchable prefix.
 parts := ARRAY[coalesce(NEW.title, ''), coalesce(NEW.tags, ''), body_prefix];
 WHILE part <= 3 LOOP
  BEGIN
   WHILE part <= 3 LOOP
    vector := to_tsvector('mainworthy_search', parts[part]);
    IF pg_column_size(vector) > 262144 THEN EXIT; END IF;
    vectors := array_append(vectors, vector);
    part := part + 1;
   END LOOP;
  EXCEPTION WHEN program_limit_exceeded THEN
   NULL;
  END;
  IF part <= 3 THEN
   parts[part] := left(parts[part], char_length(parts[part]) / 2);
  END IF;
 END LOOP;
 NEW.title_tsv := vectors[1];
 NEW.tsv := setweight(vectors[1], 'A') || setweight(vectors[2], 'B') || setweight(vectors[3], 'D');
 RETURN NEW;
END;
