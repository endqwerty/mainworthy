trigger actors.authority_actor: CREATE TRIGGER authority_actor BEFORE UPDATE ON public.actors FOR EACH ROW EXECUTE FUNCTION authority_actor_changed()
trigger batches.receipt_batch: CREATE TRIGGER receipt_batch AFTER UPDATE OF job ON public.batches FOR EACH ROW EXECUTE FUNCTION receipt_batch_fn()
trigger credentials.authority_credential: CREATE TRIGGER authority_credential BEFORE INSERT OR DELETE OR UPDATE OF actor, revoked_at, data ON public.credentials FOR EACH ROW EXECUTE FUNCTION authority_changed()
trigger excuses.receipt_excuses_delete_old: CREATE TRIGGER receipt_excuses_delete_old AFTER DELETE ON public.excuses FOR EACH ROW EXECUTE FUNCTION receipt_excuses_delete_old_fn()
trigger excuses.receipt_excuses_insert_new: CREATE TRIGGER receipt_excuses_insert_new AFTER INSERT ON public.excuses FOR EACH ROW EXECUTE FUNCTION receipt_excuses_insert_new_fn()
