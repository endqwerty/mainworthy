function authority_actor_changed: CREATE OR REPLACE FUNCTION public.authority_actor_changed()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF (NEW.org, NEW.kind, NEW.name, NEW.disabled_at) IS DISTINCT FROM (OLD.org, OLD.kind, OLD.name, OLD.disabled_at) THEN
  NEW.auth_version := OLD.auth_version + 1;
 END IF;
 RETURN NEW;
END $function$
function authority_changed: CREATE OR REPLACE FUNCTION public.authority_changed()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE affected bigint[]; row_actor bigint;
BEGIN
 IF TG_OP = 'DELETE' THEN
  IF TG_TABLE_NAME = 'sessions' THEN
   IF OLD.ended_at IS NOT NULL THEN RETURN OLD; END IF;
  ELSIF TG_TABLE_NAME IN ('tokens', 'credentials') THEN
   IF OLD.revoked_at IS NOT NULL THEN RETURN OLD; END IF;
  END IF;
 END IF;
 IF TG_TABLE_NAME = 'team_grants' THEN
  SELECT array_agg(actor ORDER BY actor) INTO affected FROM team_members WHERE team IN (NEW.team, OLD.team);
 ELSIF TG_TABLE_NAME = 'orgs' THEN
  SELECT array_agg(id ORDER BY id) INTO affected FROM actors WHERE org IN (NEW.id, OLD.id);
 ELSE
  affected := ARRAY[NEW.actor, OLD.actor];
 END IF;
 FOR row_actor IN SELECT DISTINCT value FROM unnest(affected) AS changed(value) WHERE value IS NOT NULL ORDER BY value LOOP
  PERFORM id FROM actors WHERE id = row_actor FOR NO KEY UPDATE;
  UPDATE actors SET auth_version = auth_version + 1 WHERE id = row_actor;
 END LOOP;
 IF TG_TABLE_NAME = 'team_grants' THEN
  PERFORM id FROM teams WHERE id IN (NEW.team, OLD.team) ORDER BY id FOR NO KEY UPDATE;
  IF EXISTS (SELECT FROM team_members WHERE team IN (NEW.team, OLD.team) AND NOT (actor = ANY(coalesce(affected, ARRAY[]::bigint[])))) THEN
   RAISE EXCEPTION 'team membership changed during authority lock discovery' USING ERRCODE = '40001';
  END IF;
 ELSIF TG_TABLE_NAME = 'team_members' THEN
  PERFORM id FROM teams WHERE id IN (NEW.team, OLD.team) ORDER BY id FOR NO KEY UPDATE;
 END IF;
 RETURN coalesce(NEW, OLD);
END $function$
function receipt_batch_fn: CREATE OR REPLACE FUNCTION public.receipt_batch_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.job IS DISTINCT FROM NEW.job THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.result IN (SELECT id FROM results WHERE batch=NEW.id) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_correction_delete_old_fn: CREATE OR REPLACE FUNCTION public.receipt_correction_delete_old_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.corrects IS NOT NULL THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.test=(SELECT test FROM results WHERE id=OLD.corrects) AND rt.target=(SELECT target FROM results WHERE id=OLD.corrects) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN OLD;
END;
$function$
function receipt_correction_insert_new_fn: CREATE OR REPLACE FUNCTION public.receipt_correction_insert_new_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF NEW.corrects IS NOT NULL THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.test=(SELECT test FROM results WHERE id=NEW.corrects) AND rt.target=(SELECT target FROM results WHERE id=NEW.corrects) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_correction_update_new_fn: CREATE OR REPLACE FUNCTION public.receipt_correction_update_new_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF NEW.corrects IS NOT NULL AND OLD.corrects IS DISTINCT FROM NEW.corrects THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.test=(SELECT test FROM results WHERE id=NEW.corrects) AND rt.target=(SELECT target FROM results WHERE id=NEW.corrects) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_correction_update_old_fn: CREATE OR REPLACE FUNCTION public.receipt_correction_update_old_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
 IF OLD.corrects IS NOT NULL AND OLD.corrects IS DISTINCT FROM NEW.corrects THEN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.test=(SELECT test FROM results WHERE id=OLD.corrects) AND rt.target=(SELECT target FROM results WHERE id=OLD.corrects) ON CONFLICT(run,bucket) DO NOTHING;

 END IF;
 RETURN NEW;
END;
$function$
function receipt_excuses_delete_old_fn: CREATE OR REPLACE FUNCTION public.receipt_excuses_delete_old_fn()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
INSERT INTO merge_receipt_dirty(run,bucket) SELECT rt.run,rt.result/32 FROM run_tests rt JOIN merge_receipt_heads h ON h.run=rt.run WHERE rt.signature=OLD.signature AND rt.outcome IN ('fail','error') AND h.project=OLD.project AND (OLD.target=0 OR rt.target=OLD.target) ON CONFLICT(run,bucket) DO NOTHING;

 RETURN OLD;
END;
$function$
