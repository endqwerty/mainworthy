trigger flips.receipt_flips_update_old: CREATE TRIGGER receipt_flips_update_old AFTER UPDATE ON public.flips FOR EACH ROW EXECUTE FUNCTION receipt_flips_update_old_fn()
trigger grants.authority_grant: CREATE TRIGGER authority_grant BEFORE INSERT OR DELETE OR UPDATE ON public.grants FOR EACH ROW EXECUTE FUNCTION authority_changed()
trigger orgs.authority_org: CREATE TRIGGER authority_org BEFORE UPDATE ON public.orgs FOR EACH ROW EXECUTE FUNCTION authority_changed()
trigger quarantines.receipt_quarantine_insert: CREATE TRIGGER receipt_quarantine_insert AFTER INSERT ON public.quarantines FOR EACH ROW EXECUTE FUNCTION receipt_quarantine_insert_fn()
trigger quarantines.receipt_quarantine_presence: CREATE TRIGGER receipt_quarantine_presence AFTER DELETE ON public.quarantines FOR EACH ROW EXECUTE FUNCTION receipt_quarantine_presence_fn()
trigger result_excuses.receipt_result_excuses_delete_old: CREATE TRIGGER receipt_result_excuses_delete_old AFTER DELETE ON public.result_excuses FOR EACH ROW EXECUTE FUNCTION receipt_result_excuses_delete_old_fn()
trigger result_excuses.receipt_result_excuses_insert_new: CREATE TRIGGER receipt_result_excuses_insert_new AFTER INSERT ON public.result_excuses FOR EACH ROW EXECUTE FUNCTION receipt_result_excuses_insert_new_fn()
trigger result_excuses.receipt_result_excuses_update_new: CREATE TRIGGER receipt_result_excuses_update_new AFTER UPDATE ON public.result_excuses FOR EACH ROW EXECUTE FUNCTION receipt_result_excuses_update_new_fn()
trigger result_excuses.receipt_result_excuses_update_old: CREATE TRIGGER receipt_result_excuses_update_old AFTER UPDATE ON public.result_excuses FOR EACH ROW EXECUTE FUNCTION receipt_result_excuses_update_old_fn()
trigger results.receipt_correction_delete_old: CREATE TRIGGER receipt_correction_delete_old AFTER DELETE ON public.results FOR EACH ROW EXECUTE FUNCTION receipt_correction_delete_old_fn()
trigger results.receipt_correction_insert_new: CREATE TRIGGER receipt_correction_insert_new AFTER INSERT ON public.results FOR EACH ROW EXECUTE FUNCTION receipt_correction_insert_new_fn()
trigger results.receipt_correction_update_new: CREATE TRIGGER receipt_correction_update_new AFTER UPDATE ON public.results FOR EACH ROW EXECUTE FUNCTION receipt_correction_update_new_fn()
trigger results.receipt_correction_update_old: CREATE TRIGGER receipt_correction_update_old AFTER UPDATE ON public.results FOR EACH ROW EXECUTE FUNCTION receipt_correction_update_old_fn()
trigger results.receipt_result: CREATE TRIGGER receipt_result AFTER UPDATE OF quarantine_decision, quarantine_exit, signature, method, batch, test, target ON public.results FOR EACH ROW EXECUTE FUNCTION receipt_result_fn()
trigger run_tests.receipt_run_delete: CREATE TRIGGER receipt_run_delete AFTER DELETE ON public.run_tests FOR EACH ROW EXECUTE FUNCTION receipt_run_delete_fn()
trigger run_tests.receipt_run_insert: CREATE TRIGGER receipt_run_insert AFTER INSERT ON public.run_tests FOR EACH ROW EXECUTE FUNCTION receipt_run_insert_fn()
trigger run_tests.receipt_run_update_new: CREATE TRIGGER receipt_run_update_new AFTER UPDATE ON public.run_tests FOR EACH ROW EXECUTE FUNCTION receipt_run_update_new_fn()
trigger run_tests.receipt_run_update_old: CREATE TRIGGER receipt_run_update_old AFTER UPDATE ON public.run_tests FOR EACH ROW EXECUTE FUNCTION receipt_run_update_old_fn()
trigger search_docs.search_docs_vector: CREATE TRIGGER search_docs_vector BEFORE INSERT OR UPDATE ON public.search_docs FOR EACH ROW EXECUTE FUNCTION search_docs_vector_fn()
trigger sessions.authority_session: CREATE TRIGGER authority_session BEFORE DELETE OR UPDATE OF actor, ended_at ON public.sessions FOR EACH ROW EXECUTE FUNCTION authority_changed()
trigger targets.receipt_target: CREATE TRIGGER receipt_target AFTER UPDATE OF line, change, repo, what, env ON public.targets FOR EACH ROW EXECUTE FUNCTION receipt_target_fn()
trigger team_grants.authority_team_grant: CREATE TRIGGER authority_team_grant BEFORE INSERT OR DELETE OR UPDATE ON public.team_grants FOR EACH ROW EXECUTE FUNCTION authority_changed()
trigger team_members.authority_membership: CREATE TRIGGER authority_membership BEFORE INSERT OR DELETE OR UPDATE ON public.team_members FOR EACH ROW EXECUTE FUNCTION authority_changed()
trigger tests.receipt_test: CREATE TRIGGER receipt_test AFTER UPDATE OF name, file, no, kind ON public.tests FOR EACH ROW EXECUTE FUNCTION receipt_test_fn()
trigger tokens.authority_token: CREATE TRIGGER authority_token BEFORE INSERT OR DELETE OR UPDATE OF actor, revoked_at, expires_at, hash ON public.tokens FOR EACH ROW EXECUTE FUNCTION authority_changed()"
`;
