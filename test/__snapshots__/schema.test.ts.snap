index run_tests_result_reset: CREATE INDEX run_tests_result_reset ON public.run_tests USING btree (result)
index run_tests_target_fk: CREATE INDEX run_tests_target_fk ON public.run_tests USING btree (target)
index run_tests_test: CREATE INDEX run_tests_test ON public.run_tests USING btree (test, run)
index runs_change: CREATE UNIQUE INDEX runs_change ON public.runs USING btree (project, accepts_what) WHERE (origin = 'change'::text)
index runs_change_fk: CREATE INDEX runs_change_fk ON public.runs USING btree (change)
index runs_open: CREATE INDEX runs_open ON public.runs USING btree (project, state, id DESC)
index runs_pkey: CREATE UNIQUE INDEX runs_pkey ON public.runs USING btree (id)
index runs_planned_commit: CREATE INDEX runs_planned_commit ON public.runs USING btree (project, (((accepts)::jsonb ->> 'commit'::text)), state, id DESC) WHERE (origin = 'planned'::text)
index runs_planned_receiving: CREATE INDEX runs_planned_receiving ON public.runs USING btree (project, state, id DESC) WHERE (origin = 'planned'::text)
index runs_project_id: CREATE INDEX runs_project_id ON public.runs USING btree (project, id)
index runs_project_no_key: CREATE UNIQUE INDEX runs_project_no_key ON public.runs USING btree (project, no)
index runs_scope: CREATE INDEX runs_scope ON public.runs USING btree (project, scope, id) WHERE (scope IS NOT NULL)
index runs_signoff_reset: CREATE INDEX runs_signoff_reset ON public.runs USING btree (signoff) WHERE (signoff IS NOT NULL)
index scope_moves_pkey: CREATE UNIQUE INDEX scope_moves_pkey ON public.scope_moves USING btree (id)
index scope_moves_project_reset: CREATE INDEX scope_moves_project_reset ON public.scope_moves USING btree (project)
index search_docs_pkey: CREATE UNIQUE INDEX search_docs_pkey ON public.search_docs USING btree (id)
index search_docs_project: CREATE INDEX search_docs_project ON public.search_docs USING btree (project)
index search_docs_title_tsv: CREATE INDEX search_docs_title_tsv ON public.search_docs USING gin (title_tsv)
index search_docs_tsv: CREATE INDEX search_docs_tsv ON public.search_docs USING gin (tsv)
index sessions_actor: CREATE INDEX sessions_actor ON public.sessions USING btree (actor, ended_at)
index sessions_credential: CREATE INDEX sessions_credential ON public.sessions USING btree (credential) WHERE (credential IS NOT NULL)
index sessions_hash_key: CREATE UNIQUE INDEX sessions_hash_key ON public.sessions USING btree (hash)
index sessions_pkey: CREATE UNIQUE INDEX sessions_pkey ON public.sessions USING btree (id)
index signatures_pkey: CREATE UNIQUE INDEX signatures_pkey ON public.signatures USING btree (id)
index signatures_project_hash_key: CREATE UNIQUE INDEX signatures_project_hash_key ON public.signatures USING btree (project, hash)
index slot_leases_pkey: CREATE UNIQUE INDEX slot_leases_pkey ON public.slot_leases USING btree (slot)
index slot_results_discounted_by_fk: CREATE INDEX slot_results_discounted_by_fk ON public.slot_results USING btree (discounted_by)
index slot_results_pkey: CREATE UNIQUE INDEX slot_results_pkey ON public.slot_results USING btree (slot, result)
index slot_results_result: CREATE INDEX slot_results_result ON public.slot_results USING btree (result)
index slot_results_run: CREATE INDEX slot_results_run ON public.slot_results USING btree (run)
index slots_case: CREATE INDEX slots_case ON public.slots USING btree (case_id, run)
index slots_disputed: CREATE INDEX slots_disputed ON public.slots USING btree (run) WHERE (state = 'disputed'::text)
index slots_next: CREATE INDEX slots_next ON public.slots USING btree (run, state, rank)
index slots_pkey: CREATE UNIQUE INDEX slots_pkey ON public.slots USING btree (id)
index slots_rank: CREATE INDEX slots_rank ON public.slots USING btree (run, rank)
index slots_run_case_id_obligation_key: CREATE UNIQUE INDEX slots_run_case_id_obligation_key ON public.slots USING btree (run, case_id, obligation)
index slots_run_id: CREATE INDEX slots_run_id ON public.slots USING btree (run, id)
index targets_commit: CREATE INDEX targets_commit ON public.targets USING btree (project, commit_sha)
index targets_pkey: CREATE UNIQUE INDEX targets_pkey ON public.targets USING btree (id)
index targets_project_what_env_key: CREATE UNIQUE INDEX targets_project_what_env_key ON public.targets USING btree (project, what, env)
index team_events_pkey: CREATE UNIQUE INDEX team_events_pkey ON public.team_events USING btree (id)
index team_events_project: CREATE INDEX team_events_project ON public.team_events USING btree (project) WHERE (project IS NOT NULL)
index team_events_team: CREATE INDEX team_events_team ON public.team_events USING btree (team, id)
index team_grants_pkey: CREATE UNIQUE INDEX team_grants_pkey ON public.team_grants USING btree (team, project)
index team_members_actor: CREATE INDEX team_members_actor ON public.team_members USING btree (actor, team)
index team_members_pkey: CREATE UNIQUE INDEX team_members_pkey ON public.team_members USING btree (team, actor)
index teams_org_name_key: CREATE UNIQUE INDEX teams_org_name_key ON public.teams USING btree (org, name)
index teams_pkey: CREATE UNIQUE INDEX teams_pkey ON public.teams USING btree (id)
index tests_case: CREATE INDEX tests_case ON public.tests USING btree (project, case_id)
index tests_case_id_reset: CREATE INDEX tests_case_id_reset ON public.tests USING btree (case_id) WHERE (case_id IS NOT NULL)
index tests_file: CREATE INDEX tests_file ON public.tests USING btree (project, file)
index tests_linked_by_reset: CREATE INDEX tests_linked_by_reset ON public.tests USING btree (linked_by) WHERE (linked_by IS NOT NULL)
index tests_pkey: CREATE UNIQUE INDEX tests_pkey ON public.tests USING btree (id)
index tests_project_key_key: CREATE UNIQUE INDEX tests_project_key_key ON public.tests USING btree (project, key)
index tests_project_no_key: CREATE UNIQUE INDEX tests_project_no_key ON public.tests USING btree (project, no)
index tokens_hash_key: CREATE UNIQUE INDEX tokens_hash_key ON public.tokens USING btree (hash)
index tokens_pkey: CREATE UNIQUE INDEX tokens_pkey ON public.tokens USING btree (id)
index tracker_polls_nonce_key: CREATE UNIQUE INDEX tracker_polls_nonce_key ON public.tracker_polls USING btree (nonce)
index tracker_polls_pkey: CREATE UNIQUE INDEX tracker_polls_pkey ON public.tracker_polls USING btree (decision)
index tracker_requests_pkey: CREATE UNIQUE INDEX tracker_requests_pkey ON public.tracker_requests USING btree (id)
index tracker_requests_project_reset: CREATE INDEX tracker_requests_project_reset ON public.tracker_requests USING btree (project)
index tracker_requests_queue: CREATE INDEX tracker_requests_queue ON public.tracker_requests USING btree (state, at)
index tracker_requests_result_reset: CREATE INDEX tracker_requests_result_reset ON public.tracker_requests USING btree (result)
