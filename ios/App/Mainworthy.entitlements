<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The site whose saved logins the phone's password AutoFill, and a password manager through it, offers on
	     the sign-in screen. The site must name this app in /.well-known/apple-app-site-association, which a
	     Mainworthy serves when MAINWORTHY_APPLE_APPS lists it (docs/deploy.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(MAINWORTHY_WEBCREDENTIALS_DOMAIN)</string>
	</array>
</dict>
</plist>
