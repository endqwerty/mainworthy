{
  "verdict": "Policy adoption yields between runs. The calibrated 6000-run, 750 ms regression passed 10/10 on fixed code and failed 10/10 on old code. Earlier mixed-workload results remain shared-host observations; other synchronous stages and the historical production stall remain open.",
  "base": "4fbd30cb",
  "bun": "1.4.3",
  "platform": "macOS arm64",
  "cores": 10,
  "dataset": {
    "benchmarkCases": 10000,
    "versions": 15932,
    "automatedTests": 4000,
    "results": 105123,
