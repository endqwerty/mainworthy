  "followUps": [
    {
      "stage": "Policy adoption: initial refold and eligible-question loop",
      "decision": "Implemented cooperative pauses between runs in each refold phase and between question candidates. The synchronous wrapper preserves other callers. A very large individual run or handler can still block; split inner work only with focused evidence."
    },
    {
      "stage": "Report acceptance: input/schema validation, canonical batch hash, staged JSON serialization and initial commit",
      "decision": "Still synchronous. Worker-side parse/hash or bounded resumable acceptance needs an ownership/recovery design; do not commit partial acceptance to make health respond."
    },
    {
      "stage": "Report application: 200-result/observation slices, attachment persistence, final failure raising, refold and receipt serialization",
      "decision": "Still uses its existing slices; individual slices and final refold can pause. Profile under a quiet host with SQL timing, then preserve generator pauses at the identified stage. No writer-worker or commit-boundary change in this patch."
    },
    {
      "stage": "Change merge/reopen: merge-receipt construction and question/refold lifecycle",
      "decision": "Still synchronous. If independently reproduced on a quiet host, use the same generator driver under the writer gate; receipt publication must remain atomic."
    },
    {
      "stage": "Gate, large find and Queue inbox",
      "decision": "Already reader workers after startup. No repeated multi-second stall attributed to their read work in this fixture. Do not move the same read twice; examine main-thread admission, reply validation/serialization or fallback if a quiet run reproduces it."
    },
    {
      "stage": "Archive export",
      "decision": "Already a dedicated worker and disk spool. The main thread still admits, validates the worker reply, and streams bytes. No causal CPU hotspot established for its noisy long waits; do not infer export CPU ran on the server thread from coincident health samples alone."
    },
    {
      "stage": "renewDemoWork",
      "decision": "Reads slots through the registry then takes its lease under the writer gate. No repeatable stall attributed here. It can wait behind a writer without itself blocking health; retain its current scheduling."
    }
  ],
