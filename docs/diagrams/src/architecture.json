  "cards": [
    {
      "dot": "cyan",
      "title": "The same operations everywhere",
      "items": [
        "Produce: propose, report, claim. Request: plan. Decide: decide.",
        "Read: inbox, get, find, impact, since, gate, history, timeline, check. Administer: admin.",
        "HTTP and CLI use OP_LIST. Agent tools use the MCP_OPS subset. OpenAPI describes the inputs."
      ]
    },
    {
      "dot": "violet",
      "title": "What each module owns",
      "items": [
        "suite owns cases, versions, folders, placements, proposals, requirements and covers.",
        "evidence owns tests, targets, changes, batches, results, signatures, flips, excuses, reviews and findings.",
        "runs owns runs, run_tests, slots, slot_results and depends_on. decisions owns questions, question_refs, answers and decisions.",
        "identity owns orgs, actors, grants and tokens. policy owns policies."
      ]
    },
    {
      "dot": "rose",
      "title": "A decision authorizes standing",
      "items": [
        "seal records an edit as a proposal. settle records a decision before it mints a Witness.",
        "Only a decision can adopt a case, link a test, count a cause differently, close a run or change an existing policy.",
        "A rule uses the same ledger and Witness path as a person. The first policy is seeded when a project is created."
      ]
    },
    {
      "dot": "emerald",
      "title": "An upload keeps reads responsive",
      "items": [
        "reportSteps commits acceptance first. outstanding makes each affected gate pending.",
        "processBatchSteps applies the batch in one second transaction. SLICE is 200; a yield keeps that transaction open.",
        "invokeAsync yields to the event loop. Reader threads see committed snapshots while app.gate queues other writes.",
        "The container stores casebook.db in casebook-data at /data. The React UI runs in the browser."
      ]
    }
  ]
}
